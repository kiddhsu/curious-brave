rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 一年級練習（既有）
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /progress/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 好奇小勇者（獨立 collection）
    match /curiousBrave/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
